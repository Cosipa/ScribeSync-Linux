# Configuration file for scribeSync.sh
# Override default paths by uncommenting and modifying the lines below

# Path to the assets folder for pdf notebooks (needed for symlinks)
# AssetsFolder="/home/user/ScribeSync-Linux/sync_data/pdf"

# Optional go-mtpfs regex matching manufacturer/product/serial (default: (?i)scribe)
# Use a unique serial if multiple Scribes are connected
# MtpDeviceFilter="YOUR_SCRIBE_SERIAL"
